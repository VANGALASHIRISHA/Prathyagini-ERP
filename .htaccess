DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Pass the Authorization header to PHP (many shared hosts drop it, which breaks Bearer-key API calls)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Never serve git data, archives, backups or key files
RewriteRule (^|/)\.git(/|$) - [F,L,NC]
RewriteRule \.(zip|tar|gz|tgz|7z|rar|bak|old|orig|pem|key)$ - [F,L,NC]
RewriteRule (^|/)(config\.secret\.php|Central\ License)(/|$) - [F,L,NC]

# Never expose application/config/database/license internals.
RewriteRule ^(?:app|sql|license|docs|tests|storage)(?:/|$) - [F,L,NC]
RewriteRule ^(?:config\.php|config\.example\.php|\.env|VERSION\.txt|SHA256SUMS\.txt)$ - [F,L,NC]

# Existing root files (index.php, .htaccess) are handled normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Serve the original public/ directory transparently at the domain root.
RewriteRule ^(.+)$ public/$1 [L,QSA]
</IfModule>
